# ── MySQL database ────────────────────────────────────────────────────────────
# Use TiDB Cloud (free): https://tidbcloud.com
MYSQL_HOST=gateway01.eu-central-1.prod.aws.tidbcloud.com
MYSQL_PORT=4000
MYSQL_DATABASE=kinderdesk
MYSQL_USER=your-db-user
MYSQL_PASSWORD=your-db-password

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=local-dev-secret-change-in-production

# ── Cloudflare R2 — file storage (server-side only) ───────────────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=kinderdesk
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ── SMTP — email confirmation, password reset, staff invites ──────────────────
# Use Resend (recommended): https://resend.com
#   SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_USER=resend  SMTP_PASS=<api-key>
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=your-resend-api-key
SMTP_FROM="KinderDesk <noreply@kinderdesk.in>"

# Set to "true" in local dev to skip email confirmation and auto-login on signup
SKIP_EMAIL_CONFIRMATION=true

# ── App URL (used in confirmation/reset email links) ──────────────────────────
VITE_APP_URL=https://your-production-domain.vercel.app

# ── Web Push notifications (server-side only) ─────────────────────────────────
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# ── Razorpay — platform subscription billing (server-side only) ──────────────
# These are YOUR Razorpay keys. Schools pay their subscription into this account.
RAZORPAY_KEY_ID=rzp_live_xxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# ── SMS reminders (optional) ──────────────────────────────────────────────────
# Using Fast2SMS (India). When FAST2SMS_AUTH_KEY is not set, the app still works
# and only email reminders are sent.
# FAST2SMS_AUTH_KEY=your-fast2sms-auth-key
# FAST2SMS_ROUTE=q
# FAST2SMS_LANGUAGE=english
# FAST2SMS_SENDER_ID=your-dlt-sender-id
# FAST2SMS_TEMPLATE_ID=your-dlt-template-id
# SMS_DEFAULT_COUNTRY_CODE=+91
